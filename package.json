{
  "name": "node_typescript",
  "version": "1.0.0",
  "description": "Starter Node.js, Typescript, Sequelize and Express.js.",
  "main": "dist/src/index.js",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "config": "^3.3.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "envalid": "^7.3.1",
    "express": "^4.21.0",
    "express-session": "^1.17.3",
    "helmet": "^6.0.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.0.1",
    "nodemailer": "^10.1.2",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.4.1",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.2",
    "@types/config": "^3.3.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.16",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.2",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.11.18",
    "@types/nodemailer": "^8.0.2",
    "@types/sequelize": "^4.28.14",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.1.0",
    "nodemon": "^3.1.4",
    "prettier": "^2.8.3",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.5.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.4"
  },
  "scripts": {
    "start": "node -r dotenv/config dist/src/index.js",
    "start:prod": "npm run build && cross-env NODE_ENV=production npm start",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc && npx tsc-alias",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_ENV=test jest --selectProjects unit",
    "test:coverage": "cross-env NODE_ENV=test jest --selectProjects unit --coverage",
    "test:integration": "cross-env NODE_ENV=test jest --selectProjects integration --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "cli": "npx ts-node generators/cli.ts",
    "gen-models": "npx ts-node generators/cli.ts models",
    "gen-init-models": "npx ts-node generators/cli.ts init-models",
    "gen-dtos": "npx ts-node generators/cli.ts dtos",
    "gen-docs": "npx ts-node generators/cli.ts docs",
    "gen-tests": "npx ts-node generators/cli.ts tests",
    "gen-resource": "npx ts-node generators/cli.ts resource",
    "gen-all": "npx ts-node generators/cli.ts all",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:status": "npx sequelize-cli db:migrate:status"
  },
  "author": "Nicolas Dabek",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  }
}
