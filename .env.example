PORT=3000
NODE_ENV=development

HOST_MAIL='smtp.gmail.com'
PORT_MAIL=587
USER_MAIL='user_mail@gmail.com'
PASSWORD_MAIL='password'

SECRET_SESSION='change-me'
# Sessions : SESSION_ENABLED='false' pour les couper (sinon un store est obligatoire en production)
SESSION_ENABLED='true'
SESSION_COOKIE_NAME='sid'
JWT_SECRET='change-me'
# Origines CORS autorisées, séparées par des virgules (vide = aucune)
CORS_ORIGINS=''
# Derrière un reverse proxy HTTPS : TRUST_PROXY='true' (1 saut) ou une valeur Express
# TRUST_PROXY='true'
# Swagger : actif hors production par défaut ; 'true' / 'false' pour forcer
# SWAGGER_ENABLED='false'

DB_ADDRESS='localhost'
DB_NAME='db_name'
# DB_NAME_TEST='db_name_test'  (sequelize-cli, env test ; par défaut <DB_NAME>_test)
DB_USERNAME='app_user'
DB_PASSWORD='change-me'
DB_DIR_OUTPUT_MODELS='./src/models'
DB_PORT=3306
DB_DIALECT='mysql'
DB_MODELS_IN_TYPESCRIPT='true'
DB_SYNC='false'
DB_SYNC_ALTER='false'

USER_PASSWORD_HASH_SALT=10

CRUD_BLOCKED_MODELS='users'
# CRUD_ALLOWED_MODELS='products'
# JWT exigé par défaut sur tout le CRUD générique ; 'true' rend les lectures anonymes (jamais les écritures)
GENERIC_CRUD_PUBLIC_READ='false'
API_TITLE='API Documentation'
API_VERSION='1.0.0'
